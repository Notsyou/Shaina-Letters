# --- Passwords ---
# The password Shai types to read her letters
READER_PASSWORD=change-me
# Your admin password (for /admin)
ADMIN_PASSWORD=change-me-too
# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# --- Database ---
# Neon/Supabase Postgres URL. Leave empty locally to use the built-in file database in .data/
DATABASE_URL=

# --- Email (Gmail) ---
# Gmail address that sends the emails, and where YOUR alerts go
GMAIL_USER=notzyou1@gmail.com
# A Gmail "App password" (Google Account > Security > 2-Step Verification > App passwords). NOT your normal password.
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=notzyou1@gmail.com

# --- Photos ---
# From the Cloudinary dashboard. Leave empty locally to store photos in .data/uploads
CLOUDINARY_URL=

# --- Misc ---
# Public URL of the site, used for links in emails
SITE_URL=http://localhost:3000
# Secret for the cron ping URL: /api/cron/tick?key=...
CRON_SECRET=

# Time zone used for dates written in emails
TIMEZONE=Asia/Manila
